# Hanya dipakai saat `npm start` (mode pengembangan). Tidak ikut ke build produksi.
#
# React Scripts 5 mematikan pemeriksaan hostname kalau fitur `proxy` dipakai, lalu
# mengambil nama host dari paket `ip` — paket itu error di Node 26 sehingga daftar
# host jadi kosong dan dev server gagal start dengan pesan
# "options.allowedHosts[0] should be a non-empty string".
# Baris di bawah mematikan pemeriksaan host secara eksplisit (aman untuk lokal).
DANGEROUSLY_DISABLE_HOST_CHECK=true
