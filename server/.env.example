# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Jalankan dengan: npm start (script sudah membaca .env otomatis)

PORT=4000

# WAJIB diganti dengan string acak panjang. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# Lokasi database SQLite + folder unggahan. Default: ./data
# DATA_DIR=./data

# Password awal (hanya dipakai saat database masih kosong)
SEED_ADMIN_PASSWORD=Admin#2026
SEED_USER_PASSWORD=Budi#2026

# Set true HANYA jika situs sudah memakai HTTPS (cookie hanya dikirim lewat HTTPS)
COOKIE_SECURE=false
